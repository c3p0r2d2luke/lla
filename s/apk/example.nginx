# Add these locations to the existing HTTPS server for lla.ipv64.net.
# If using this as a standalone virtual host, retain the TLS certificate
# paths below and ensure the certificate already exists.
server {
    listen 443 ssl;
    server_name lla.ipv64.net;

    ssl_certificate     /etc/letsencrypt/live/lla.ipv64.net/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/lla.ipv64.net/privkey.pem;

    # Keep the trailing slash: the app uses relative API and asset URLs.
    location = /s/apk {
        return 301 /s/apk/;
    }

    location /s/apk/ {
        auth_basic "APK Playground";
        auth_basic_user_file /etc/nginx/.htpasswd-apk;

        client_max_body_size 300m;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # The trailing slash strips /s/apk/ before proxying.
        proxy_pass http://127.0.0.1:4178/;
    }
}
